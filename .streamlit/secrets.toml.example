# ============================================================
# secrets.toml.example
#
# Option A – Streamlit Cloud / local dev
#   Copy this file to .streamlit/secrets.toml and fill in the values.
#
# Option B – Any other platform (Docker, Railway, Fly.io, …)
#   Skip secrets.toml entirely and export the equivalent environment
#   variables shown in the comments next to each key.
# ============================================================

[auth]
# env: AUTH_REDIRECT_URI
redirect_uri = "http://localhost:8501/oauth2callback"
# env: AUTH_COOKIE_SECRET
cookie_secret = "replace-with-a-long-random-value"
# env: AUTH_CLIENT_ID
client_id = "replace-with-your-google-oauth-client-id"
# env: AUTH_CLIENT_SECRET
client_secret = "replace-with-your-google-oauth-client-secret"
# env: AUTH_SERVER_METADATA_URL
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# (no env-var equivalent; set this in secrets.toml only)
client_kwargs = { "hd" = "fortyguard.com", "prompt" = "select_account" }

[app]
# env: APP_ALLOWED_DOMAIN
allowed_domain = "fortyguard.com"

[webhooks]
# env: WEBHOOKS_CHAT_URL
chat_url = "https://n8n-kczt.srv1629125.hstgr.cloud/webhook/brain-message"
# env: WEBHOOKS_RESET_URL
reset_url = "https://n8n-kczt.srv1629125.hstgr.cloud/webhook/reset-chat"
# env: WEBHOOKS_TIMEOUT_SECONDS
timeout_seconds = 90
